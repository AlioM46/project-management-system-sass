{
  "info": {
    "name": "RBAC Recent Additions",
    "description": "Only the recently added Roles & Permissions requests for merging into an existing Postman workspace collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Roles & Permissions",
      "item": [
        {
          "name": "Roles",
          "item": [
            {
              "name": "Create Role",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}",
                    "type": "text"
                  },
                  {
                    "key": "X-Workspace-Id",
                    "value": "{{workspace_id}}",
                    "type": "text"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Project Lead\",\n  \"slug\": \"project-lead\",\n  \"description\": \"Custom role for project leadership.\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/roles-permissions/roles",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "roles-permissions",
                    "roles"
                  ]
                }
              }
            },
            {
              "name": "Show Role",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}",
                    "type": "text"
                  },
                  {
                    "key": "X-Workspace-Id",
                    "value": "{{workspace_id}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/roles-permissions/roles/{{role_id}}",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "roles-permissions",
                    "roles",
                    "{{role_id}}"
                  ]
                }
              }
            },
            {
              "name": "Update Role",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}",
                    "type": "text"
                  },
                  {
                    "key": "X-Workspace-Id",
                    "value": "{{workspace_id}}",
                    "type": "text"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Project Manager\",\n  \"slug\": \"project-manager\",\n  \"description\": \"Updated custom role description.\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/roles-permissions/roles/{{role_id}}",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "roles-permissions",
                    "roles",
                    "{{role_id}}"
                  ]
                }
              }
            },
            {
              "name": "Delete Role",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}",
                    "type": "text"
                  },
                  {
                    "key": "X-Workspace-Id",
                    "value": "{{workspace_id}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/roles-permissions/roles/{{role_id}}",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "roles-permissions",
                    "roles",
                    "{{role_id}}"
                  ]
                }
              }
            },
            {
              "name": "Update Role Permissions",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}",
                    "type": "text"
                  },
                  {
                    "key": "X-Workspace-Id",
                    "value": "{{workspace_id}}",
                    "type": "text"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"permissions\": [\n    \"project.view\",\n    \"project.create\",\n    \"task.view\"\n  ]\n}"
                },
                "url": {
                  "raw": "{{base_url}}/roles-permissions/roles/{{role_id}}/permissions",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "roles-permissions",
                    "roles",
                    "{{role_id}}",
                    "permissions"
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "workspace_id",
      "value": ""
    },
    {
      "key": "role_id",
      "value": ""
    }
  ]
}
