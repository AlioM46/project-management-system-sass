                                        "type": "text"
                                    },
                                    {
                                        "key": "Content-Type",
                                        "value": "application/json",
                                        "type": "text"
                                    }
                                ],
                                "url": {
                                    "raw": "{{base_url}}/tasks",
                                    "host": [
                                        "{{base_url}}"
                                    ],
                                    "path": [
                                        "tasks"
                                    ]
                                },
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n  \"project_id\": {{project_id}},\n  \"title\": \"Design task board\",\n  \"description\": \"Build the initial Kanban board screens and API integration.\",\n  \"assignee_ids\": [{{assignee_user_id}}, {{second_assignee_user_id}}]\n}"
                                }
                            }
                        },
                        {
