                                        "key": "Authorization",
                                        "value": "Bearer {{token}}",
                                        "type": "text"
                                    },
                                    {
                                        "key": "X-Workspace-Id",
                                        "value": "{{workspace_id}}",
                                        "type": "text"
                                    }
                                ],
                                "url": {
