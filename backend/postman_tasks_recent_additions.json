                                        "key": "Authorization",
                                        "value": "Bearer {{token}}",
                                        "type": "text"
                                    },
                                    {
                                        "key": "X-Workspace-Id",
                                        "value": "{{workspace_id}}",
                                        "type": "text"
                                    },
                                    {
                                        "key": "Content-Type",
                                        "value": "application/json",
                                        "type": "text"
                                    }
                                ],
                                "url": {
                                    "raw": "{{base_url}}/tasks/{{task_id}}",
                                    "host": [
                                        "{{base_url}}"
                                    ],
                                    "path": [
                                        "tasks",
                                        "{{task_id}}"
                                    ]
                                },
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n  \"title\": \"Design task board v2\",\n  \"description\": \"Refine the Kanban experience and empty states.\",\n  \"status\": \"in_progress\"\n}"
                                }
                            }
                        },
                        {
                            "name": "Delete Task",
                            "request": {
                                "method": "DELETE",
                                "header": [
                                    {
                                        "key": "Authorization",
                                        "value": "Bearer {{token}}",
                                        "type": "text"
                                    },
                                    {
                                        "key": "X-Workspace-Id",
                                        "value": "{{workspace_id}}",
                                        "type": "text"
                                    }
                                ],
                                "url": {
                                    "raw": "{{base_url}}/tasks/{{task_id}}",
                                    "host": [
                                        "{{base_url}}"
                                    ],
                                    "path": [
                                        "tasks",
                                        "{{task_id}}"
                                    ]
                                }
                            }
                        }
                    ]
