            },
            {
              "name": "Restore Workspace",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/workspaces/{{workspace_restore_id}}/restore",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "workspaces",
                    "{{workspace_restore_id}}",
                    "restore"
                  ]
