                "url": {
                  "raw": "{{base_url}}/workspaces/members/accept-invite",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "workspaces",
                    "members",
                    "accept-invite"
                  ]
                }
              }
            }
          ]
        },
