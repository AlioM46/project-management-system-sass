{
  "info": {
    "name": "Project Management System API",
    "description": "Combined Postman collection for Auth, RolesPermissions, and Workspace API routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "jwt_token",
      "value": ""
    },
    {
      "key": "workspace_id",
      "value": ""
    },
    {
      "key": "member_id",
      "value": ""
    },
    {
      "key": "workspace_restore_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Root",
      "item": [
        {
          "name": "API Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "User",
          "item": [
            {
              "name": "Register",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/auth/register",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "auth",
                    "register"
                  ]
                }
              }
            },
            {
              "name": "Login",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/auth/login",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "auth",
                    "login"
                  ]
                }
              }
            },
            {
              "name": "Me",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/auth/me",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "auth",
                    "me"
                  ]
                }
              }
            },
            {
              "name": "Logout",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/auth/logout",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "auth",
                    "logout"
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "Password",
          "item": [
            {
              "name": "Send Reset Link",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"user@example.com\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/auth/password/send-reset-link",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "auth",
                    "password",
                    "send-reset-link"
                  ]
                }
              }
            },
            {
              "name": "Reset Password",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"user@example.com\",\n  \"token\": \"reset-token\",\n  \"password\": \"new-password123\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/auth/password/reset-password",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "auth",
                    "password",
                    "reset-password"
                  ]
                }
              }
            },
            {
              "name": "Change Password",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/auth/password/change-password",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "auth",
                    "password",
                    "change-password"
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "Email",
          "item": [
            {
              "name": "Verify Email",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/auth/email/verify/:id/:hash",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "auth",
                    "email",
                    "verify",
                    ":id",
                    ":hash"
                  ]
                }
              }
            },
            {
              "name": "Send Email Verification",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/auth/email/send-verification",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "auth",
                    "email",
                    "send-verification"
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Roles & Permissions",
      "item": [
        {
          "name": "Permissions",
          "item": [
            {
              "name": "List Permissions",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/roles-permissions/permissions",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "roles-permissions",
                    "permissions"
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "Roles",
          "item": [
            {
              "name": "List Roles",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "X-Workspace-Id",
                    "value": "{{workspace_id}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/roles-permissions/roles",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "roles-permissions",
                    "roles"
                  ]
                }
              }
            },
            {
              "name": "Create Role",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "X-Workspace-Id",
                    "value": "{{workspace_id}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Project Lead\",\n  \"slug\": \"project-lead\",\n  \"description\": \"Custom role for project leadership.\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/roles-permissions/roles",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "roles-permissions",
                    "roles"
                  ]
                }
              }
            },
            {
              "name": "Show Role",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "X-Workspace-Id",
                    "value": "{{workspace_id}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/roles-permissions/roles/{{role_id}}",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "roles-permissions",
                    "roles",
                    "{{role_id}}"
                  ]
                }
              }
            },
            {
              "name": "Update Role",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "X-Workspace-Id",
                    "value": "{{workspace_id}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Project Manager\",\n  \"slug\": \"project-manager\",\n  \"description\": \"Updated custom role description.\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/roles-permissions/roles/{{role_id}}",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "roles-permissions",
                    "roles",
                    "{{role_id}}"
                  ]
                }
              }
            },
            {
              "name": "Delete Role",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "X-Workspace-Id",
                    "value": "{{workspace_id}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/roles-permissions/roles/{{role_id}}",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "roles-permissions",
                    "roles",
                    "{{role_id}}"
                  ]
                }
              }
            },
            {
              "name": "Update Role Permissions",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "X-Workspace-Id",
                    "value": "{{workspace_id}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"permissions\": [\n    \"project.view\",\n    \"project.create\",\n    \"task.view\"\n  ]\n}"
                },
                "url": {
                  "raw": "{{base_url}}/roles-permissions/roles/{{role_id}}/permissions",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "roles-permissions",
                    "roles",
                    "{{role_id}}",
                    "permissions"
                  ]
                }
              }
            },
            {
              "name": "Sync Role Defaults",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "X-Workspace-Id",
                    "value": "{{workspace_id}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{}"
                },
                "url": {
                  "raw": "{{base_url}}/roles-permissions/defaults/sync",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "roles-permissions",
                    "defaults",
                    "sync"
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Workspace",
      "item": [
        {
          "name": "Workspace",
          "item": [
            {
              "name": "List Workspaces",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/workspaces",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "workspaces"
                  ]
